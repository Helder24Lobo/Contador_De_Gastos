<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.personalfinance.contador.controller.GastosFijosController">
    <Label styleClass="view-title" text="Gastos Fijos Mensuales" />

    <!-- Panel de Totales de Gastos Fijos -->
    <HBox spacing="15.0">
        <VBox styleClass="card-balance" prefWidth="250.0">
            <Label styleClass="card-title" text="TOTAL GASTOS FIJOS DEL MES" />
            <Label fx:id="lblTotalFijos" styleClass="card-value, value-fijo" text="\$0.00" />
        </VBox>
        <VBox styleClass="card-balance" prefWidth="250.0">
            <Label styleClass="card-title" text="PORCENTAJE RESPECTO A INGRESOS" />
            <Label fx:id="lblPorcentajeIngresos" styleClass="card-value, value-balance" text="0.0%" />
        </VBox>
    </HBox>

    <SplitPane dividerPositions="0.35" style="-fx-background-color: transparent; -fx-box-border: transparent;" VBox.vgrow="ALWAYS">
        <!-- Formulario (Izquierda) -->
        <VBox spacing="15.0" styleClass="card-balance" style="-fx-pref-width: 320px;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3f72af;" text="Datos del Gasto Fijo" />
            
            <GridPane vgap="12.0" hgap="10.0">
                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints minWidth="100" />
                </columnConstraints>
                
                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="txtNombre" prefWidth="200.0" promptText="Ej: Arriendo, Internet" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                
                <Label text="Valor Mensual:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="txtValor" prefWidth="200.0" promptText="0.00" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                
                <Label text="Día de Cobro:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="txtDiaCobro" prefWidth="200.0" promptText="Día del 1 al 31" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                
                <Label text="Estado:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <ComboBox fx:id="cbEstado" prefWidth="200.0" GridPane.rowIndex="3" GridPane.columnIndex="1" />
            </GridPane>
            
            <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#handleLimpiar" styleClass="btn-secondary" text="Limpiar" />
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#handleGuardar" styleClass="btn-primary" text="Guardar" />
            </HBox>
            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#handleEliminar" styleClass="btn-danger" text="Eliminar" visible="false" />
            </HBox>
        </VBox>

        <!-- Tabla (Derecha) -->
        <VBox spacing="10.0" style="-fx-padding: 0 0 0 15;">
            <!-- Tabla de Gastos Fijos -->
            <TableView fx:id="tblGastosFijos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="220.0" text="Servicio / Gasto" />
                    <TableColumn fx:id="colValor" prefWidth="130.0" text="Valor" />
                    <TableColumn fx:id="colDiaCobro" prefWidth="100.0" text="Día Cobro" />
                    <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                </columns>
            </TableView>
        </VBox>
    </SplitPane>
</VBox>
