<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.personalfinance.contador.controller.BudgetsController">
    <Label styleClass="view-title" text="Presupuesto Mensual por Categoría" />

    <SplitPane dividerPositions="0.35" style="-fx-background-color: transparent; -fx-box-border: transparent;" VBox.vgrow="ALWAYS">
        <!-- Formulario (Izquierda) -->
        <VBox spacing="15.0" styleClass="card-balance" style="-fx-pref-width: 320px;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3f72af;" text="Definir Presupuesto" />
            
            <GridPane vgap="12.0" hgap="10.0">
                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints minWidth="120" />
                </columnConstraints>
                
                <Label text="Categoría:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <ComboBox fx:id="cbCategoria" prefWidth="180.0" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                
                <Label text="Límite Mensual:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="txtValor" prefWidth="180.0" promptText="0.00" GridPane.rowIndex="1" GridPane.columnIndex="1" />
            </GridPane>
            
            <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#handleLimpiar" styleClass="btn-secondary" text="Limpiar" />
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#handleGuardar" styleClass="btn-primary" text="Guardar" />
            </HBox>
            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#handleEliminar" styleClass="btn-danger" text="Eliminar" visible="false" />
            </HBox>
        </VBox>

        <!-- Tabla (Derecha) -->
        <VBox spacing="10.0" style="-fx-padding: 0 0 0 15;">
            <!-- Tabla de Presupuestos -->
            <TableView fx:id="tblPresupuestos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCategoria" prefWidth="150.0" text="Categoría" />
                    <TableColumn fx:id="colPresupuesto" prefWidth="130.0" text="Presupuesto" />
                    <TableColumn fx:id="colGastado" prefWidth="130.0" text="Gastado" />
                    <TableColumn fx:id="colConsumo" prefWidth="220.0" text="Consumo (%)" />
                </columns>
            </TableView>
        </VBox>
    </SplitPane>
</VBox>
