<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.personalfinance.contador.controller.StatisticsController">
    <VBox spacing="20.0" styleClass="content-area">
        <Label styleClass="view-title" text="Estadísticas y Tendencias"/>

        <!-- Filtros de fecha rápidos -->
        <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="card-balance"
              style="-fx-pref-height: 60px; -fx-padding: 10;">
            <Label text="Intervalo:"/>
            <ComboBox fx:id="cbRango" onAction="#handleRangoChange" prefWidth="150.0"/>

            <Label text="Desde:"/>
            <DatePicker fx:id="dpDesde" prefWidth="120.0"/>

            <Label text="Hasta:"/>
            <DatePicker fx:id="dpHasta" prefWidth="120.0"/>

            <Button mnemonicParsing="false" onAction="#cargarGraficas" styleClass="btn-primary" text="Generar"/>
        </HBox>

        <!-- Primera Fila: Distribución y Comparativa -->
        <HBox spacing="20.0">
            <VBox styleClass="card-balance" HBox.hgrow="ALWAYS" prefHeight="350.0" prefWidth="450.0" alignment="CENTER">
                <Label styleClass="card-title" text="GASTOS POR CATEGORÍA"/>
                <PieChart fx:id="chartCategorias" prefHeight="300.0"/>
            </VBox>

            <VBox styleClass="card-balance" HBox.hgrow="ALWAYS" prefHeight="350.0" prefWidth="450.0" alignment="CENTER">
                <Label styleClass="card-title" text="INGRESOS VS GASTOS"/>
                <BarChart fx:id="chartComparativa" prefHeight="300.0">
                    <xAxis>
                        <CategoryAxis label="Concepto"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Valor ($)"/>
                    </yAxis>
                </BarChart>
            </VBox>
        </HBox>

        <!-- Segunda Fila: Evolución Temporal -->
        <VBox styleClass="card-balance" prefHeight="350.0" alignment="CENTER">
            <Label styleClass="card-title" text="EVOLUCIÓN DEL BALANCE NETO"/>
            <LineChart fx:id="chartEvolucion" prefHeight="300.0">
                <xAxis>
                    <CategoryAxis label="Fecha / Período"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Balance Neto ($)"/>
                </yAxis>
            </LineChart>
        </VBox>
    </VBox>
</ScrollPane>
